{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Metro picks AppMap.native.tsx / AppMap.web.tsx; teach tsc the same order.
    "moduleSuffixes": [".native", ""]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/**",
    "node_modules"
  ]
}
