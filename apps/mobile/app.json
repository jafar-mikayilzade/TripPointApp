{
  "expo": {
    "name": "TripPoint",
    "slug": "trippoint-app",
    "scheme": "trippoint",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jafar.TripPoint",
      "versionCode": 17,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0E5837",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "trippoint",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "trippoint",
              "host": "auth",
              "pathPrefix": "/reset-password"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "trippoint",
              "host": "listing",
              "pathPrefix": "/"
            }
          ]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAffY5-DqNN2620EmiRq3cPFf8KCDf6ZIA"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TripPoint sizə ən yaxın yerləri göstərmək üçün məkanınızdan istifadə edir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TripPoint yer şəkillərini yükləmək üçün qalereyanıza giriş istəyir."
        }
      ],
      "expo-dev-client",
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0E5837",
          "defaultChannel": "trippoint-default"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b06167c8-d122-4f72-850e-61100f51228d"
      },
      "googleWebClientId": "361114640439-fof8seso1jgth8kss8v2fi7tsc091v0n.apps.googleusercontent.com",
      "googleMapsKey": "AIzaSyAx_gGukcD-MTvAc1clUwXdvuK4ARNdODU",
      "telegramBotUsername": "Trip_PointBot"
    },
    "owner": "mikatu95"
  }
}
