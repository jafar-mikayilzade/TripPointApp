EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Local: PC LAN IP (localhost real device-da işləmir)
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
# Production (Railway):
EXPO_PUBLIC_API_URL=https://trippointapp-production.up.railway.app
# Public bot username (no @, not a secret) — Profil → Telegram bağla
# EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername
# Push/Telegram mirrors authenticate with the user's Supabase session token —
# no server secret belongs in this file, everything here ships in the bundle.
# Optional Sentry (no-op until @sentry/react-native + rebuild)
# EXPO_PUBLIC_SENTRY_DSN=

