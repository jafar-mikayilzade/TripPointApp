SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=
# Optional: tips for POST /api/plan-route (itinerary works without it)
ANTHROPIC_API_KEY=
# Optional Telegram (Railway): TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (admin),
# TELEGRAM_NOTIFY_SECRET, TELEGRAM_WEBHOOK_SECRET — never commit real values
# TELEGRAM_NOTIFY_SECRET=long-random-string
# Mobile must use the same value as EXPO_PUBLIC_NOTIFY_SECRET (X-Notify-Secret)
# Cron jobs: POST /api/jobs/* with header X-Cron-Secret
# CRON_SECRET=long-random-string
# (falls back to TELEGRAM_NOTIFY_SECRET if CRON_SECRET unset)
# Optional rate limits (requests per 60s per IP)
# RATE_LIMIT_PLAN_ROUTE=5
# RATE_LIMIT_LIVE_PLACES=30
# RATE_LIMIT_SYNC_PLACES=10
# RATE_LIMIT_UPSERT_PLACE=20
# Optional Sentry
# SENTRY_DSN=
# mock | osm | google | hybrid
# hybrid = Google (restaurant/hotel/…) + OSM (nature/waterfall/historical/…)
DATA_SOURCE=hybrid
# Optional: comma-separated Overpass mirrors
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
