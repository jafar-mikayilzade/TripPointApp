SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=
# Optional: tips for POST /api/plan-route (itinerary works without it)
ANTHROPIC_API_KEY=
# Optional Telegram (Railway): TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (admin),
# TELEGRAM_NOTIFY_SECRET, TELEGRAM_WEBHOOK_SECRET — never commit real values
# TELEGRAM_NOTIFY_SECRET=long-random-string
# Server-to-server only (curl/tooling). The app authenticates with its Supabase
# session token instead, so this value must never be shipped to the client.
# Cron jobs: POST /api/jobs/* with header X-Cron-Secret
# REQUIRED for cron; must differ from TELEGRAM_NOTIFY_SECRET, which the mobile
# app ships publicly in its bundle. /api/jobs/* returns 503 while this is unset.
# CRON_SECRET=long-random-string
# Optional rate limits (requests per 60s per IP)
# RATE_LIMIT_PLAN_ROUTE=5
# RATE_LIMIT_LIVE_PLACES=30
# RATE_LIMIT_SYNC_PLACES=10
# RATE_LIMIT_UPSERT_PLACE=20
# RATE_LIMIT_ROUTE_CANDIDATES=60
# RATE_LIMIT_WEATHER=60
# Optional Sentry
# SENTRY_DSN=
# mock | osm | google | hybrid
# DATA_SOURCE controls /api/sync-places fetch backend (OSM attractions → pois).
# AI plan-route / Telegram / route-candidates always use DB `pois` (not live Overpass).
# hybrid = Google (restaurant/hotel/…) + OSM attractions on sync.
DATA_SOURCE=osm
# Optional: comma-separated Overpass mirrors (leave unset to use built-in 4).
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
